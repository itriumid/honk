{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the menu bar popover",
  "windows": ["main", "popover"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
